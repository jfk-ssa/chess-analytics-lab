# Local engine, Maia, and opening-visit pointers. Examples live beside these names.
# Maia weights downloaded by scripts/fetch_maia_weights.py land under data/models/,
# which /data/* already ignores.
/config/engine.json
/config/maia.json
/config/opening-visits.json
# Generated opening rankings. Restore with scripts/materialize_opening_positions.py
# or regenerate with scripts/summarize_opening_positions.py. The publication
# hash remains in reports/opening-positions-checkpoint.json.
/reports/opening-positions.json
/reports/maia-corpus-calibration-*
