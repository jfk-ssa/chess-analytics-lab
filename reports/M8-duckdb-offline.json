  "sql_preview": "-- Run only with an explicit key and gross cap in an isolated DuckDB version.\n-- INSTALL/LOAD are intentionally omitted: pinned DuckDB 1.4.1 has no Jev binary.\nSET jev_model = 'jev-1.13.0';\nSET jev_batch_size = 20;\nSET jev_concurrency = 1;\nSET jev_max_retries = 0;\nSET jev_max_rows_per_statement = 40;\nSET jev_max_chars_per_statement = 16000;\nSELECT id, label, jev_eval(struct_pack(question := question), 'Select the primary Chess Analytics Lab route. Missing referent: clarify. Out-of-scope, causal, personal or live request: unsupported. Otherwise choose the matching opening, clock or coverage route.', 'choice', ['opening_usage', 'opening_score', 'opening_compare', 'clock_bucket', 'clock_compare', 'coverage', 'clarify', 'unsupported']) AS judgment\nFROM routing_questions ORDER BY id;\nSELECT jev_stats();\n"
