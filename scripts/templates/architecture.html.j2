<h2>Follow a question through the system</h2><p>Select a stage to inspect its role and code.</p><ol class="pipeline" aria-label="Pipeline stages">{% for stage in stages %}<li><a href="#stage-{{ stage.key }}"><strong>{{ stage.name }}</strong><small>{{ stage.desc }}</small></a></li>{% endfor %}</ol>{% for stage in stages %}<details class="definition" id="stage-{{ stage.key }}"><summary>{{ stage.name }}</summary><p>{{ stage.desc }}</p><a href="{{ repo_url }}{{ stage.path }}">Inspect {{ stage.name_lower }} code</a></details>{% endfor %}
